{%- comment -%} WhatsApp chat button and the accessibility menu. {%- endcomment -%}
{%- if settings.whatsapp_number != blank -%}
  {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
  <a class="fab fab--wa" href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener" aria-label="{{ 'general.whatsapp' | t }}">
    {%- render 'icon', name: 'whatsapp' -%}
  </a>
{%- endif -%}

{%- if settings.a11y_enabled -%}
  <button type="button" class="fab fab--a11y" data-a11y-toggle aria-expanded="false" aria-controls="a11y-panel" aria-label="{{ 'accessibility.menu' | t }}">
    {%- render 'icon', name: 'accessibility' -%}
  </button>
  <div id="a11y-panel" class="a11y-panel" role="region" aria-label="{{ 'accessibility.title' | t }}" hidden>
    <p class="h-lg" style="font-family: var(--f-display)">{{ 'accessibility.title' | t }}</p>
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: var(--fs-sm)">
      <span>{{ 'accessibility.text_size' | t }}</span>
      <span class="qty">
        <button type="button" data-a11y-scale="-0.1" aria-label="{{ 'accessibility.smaller' | t }}">−</button>
        <span data-a11y-scale-label style="width: 48px">100%</span>
        <button type="button" data-a11y-scale="0.1" aria-label="{{ 'accessibility.larger' | t }}">+</button>
      </span>
    </div>
    <div class="a11y-panel__grid">
      <button type="button" class="a11y-opt" data-a11y="contrast" aria-pressed="false"><span aria-hidden="true">◐</span><span>{{ 'accessibility.contrast' | t }}</span></button>
      <button type="button" class="a11y-opt" data-a11y="links" aria-pressed="false"><span aria-hidden="true">⎁</span><span>{{ 'accessibility.links' | t }}</span></button>
      <button type="button" class="a11y-opt" data-a11y="font" aria-pressed="false"><span aria-hidden="true">Aa</span><span>{{ 'accessibility.font' | t }}</span></button>
      <button type="button" class="a11y-opt" data-a11y="still" aria-pressed="false"><span aria-hidden="true">❚❚</span><span>{{ 'accessibility.still' | t }}</span></button>
    </div>
    <div class="a11y-panel__foot">
      <button type="button" class="link-btn" data-a11y-reset>{{ 'accessibility.reset' | t }}</button>
      {%- if settings.a11y_statement_url != blank -%}
        <a href="{{ settings.a11y_statement_url }}">{{ 'accessibility.statement' | t }}</a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
