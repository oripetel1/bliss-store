{%- comment -%}
  Line icons (mirrored in assets/bliss.js). Accepts: name, class (optional)
{%- endcomment -%}
{%- capture paths -%}
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>
    {%- when 'user' -%}<circle cx="12" cy="8" r="3.6"/><path d="M4.5 20c1.2-3.6 4-5.4 7.5-5.4s6.3 1.8 7.5 5.4"/>
    {%- when 'heart' -%}<path d="M12 20s-7.5-4.6-7.5-10.1A4.2 4.2 0 0 1 12 7.3a4.2 4.2 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20Z"/>
    {%- when 'bag' -%}<path d="M5 8h14l-1 12H6L5 8Z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>
    {%- when 'menu' -%}<path d="M3.5 8h17M3.5 16h11"/>
    {%- when 'close' -%}<path d="m6 6 12 12M18 6 6 18"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'arrow' -%}<path d="M4 12h15M14 7l5 5-5 5"/>
    {%- when 'arrow-back' -%}<path d="M20 12H5M10 7l-5 5 5 5"/>
    {%- when 'down' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'truck' -%}<path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="6.5" cy="17.5" r="1.6"/><circle cx="16.5" cy="17.5" r="1.6"/>
    {%- when 'exchange' -%}<path d="M4 9h12a4 4 0 0 1 0 8h-3"/><path d="m8 5-4 4 4 4"/>
    {%- when 'card' -%}<rect x="3" y="6" width="18" height="12.5" rx="1.5"/><path d="M3 10h18M6.5 15h4"/>
    {%- when 'chat' -%}<path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l1-4.2A8 8 0 1 1 20 12Z"/>
    {%- when 'ruler' -%}<path d="M3 15.5 15.5 3 21 8.5 8.5 21z"/><path d="m7 12 2 2M10 9l2 2M13 6l2 2"/>
    {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'lock' -%}<rect x="4.5" y="10.5" width="15" height="9.5" rx="1.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>
    {%- when 'gift' -%}<rect x="4" y="10" width="16" height="10"/><path d="M3 7h18v3H3zM12 7v13M12 7c-1.5-3-5-3.5-5-1.5S10 7 12 7Zm0 0c1.5-3 5-3.5 5-1.5S14 7 12 7Z"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="8"/><path d="M12 8v4l2.5 2.5"/>
    {%- when 'sparkle' -%}<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"/>
    {%- when 'instagram' -%}<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6"/>
    {%- when 'facebook' -%}<path d="M14 8.5h2.5V5H14a4 4 0 0 0-4 4v2H7.5v3.5H10V21h3.5v-6.5H16l.5-3.5h-3V9.2c0-.4.3-.7.5-.7Z"/>
    {%- when 'tiktok' -%}<path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.4 2.6 2.2 4.3 5 4.5"/>
    {%- when 'pinterest' -%}<circle cx="12" cy="12" r="8.5"/><path d="m10.5 20 2-8.5M10.8 14.2c.6.9 1.4 1.3 2.4 1.3 2.2 0 3.6-2 3.6-4.4 0-2.6-2-4.3-4.6-4.3-3 0-4.7 2-4.7 4.2 0 1 .4 2 1.2 2.4"/>
  {%- endcase -%}
{%- endcapture -%}
{%- if name == 'whatsapp' -%}
  <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 3.5A12.4 12.4 0 0 0 5.3 22.2L3.6 28.4l6.4-1.7A12.4 12.4 0 1 0 16 3.5Zm0 22.6a10.2 10.2 0 0 1-5.2-1.4l-.4-.2-3.8 1 1-3.7-.2-.4A10.2 10.2 0 1 1 16 26.1Zm5.6-7.6c-.3-.2-1.8-.9-2.1-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7.1a8.3 8.3 0 0 1-4.1-3.6c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-1-2.3c-.2-.6-.5-.5-.7-.5h-.6a1.1 1.1 0 0 0-.8.4 3.4 3.4 0 0 0-1.1 2.5 5.9 5.9 0 0 0 1.2 3.1 13.4 13.4 0 0 0 5.2 4.6c1.9.8 2.7.9 3.6.7a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.2-.3-.3-.6-.4Z"/></svg>
{%- elsif name contains 'care-' -%}
  <svg viewBox="0 0 26 26" aria-hidden="true" focusable="false">
    {%- case name -%}
      {%- when 'care-wash' -%}<path d="M3 8h20l-2.2 12.5H5.2Z"/><path d="M3 8c2 2 4 2 6 0s4-2 6 0 4 2 6 0"/><text x="13" y="18" text-anchor="middle">30</text>
      {%- when 'care-bleach' -%}<path d="M13 4 23 21H3Z"/><path d="m7 9 12 12M19 9 7 21"/>
      {%- when 'care-iron' -%}<path d="M4 19h18v-3a6 6 0 0 0-6-6H9l-1.5-3H5"/><circle cx="14" cy="15.5" r=".9"/>
      {%- when 'care-dry' -%}<rect x="4" y="4" width="18" height="18"/><path d="M8 13h10M4 9l5-5M4 13l9-9"/>
      {%- when 'care-tumble' -%}<rect x="4" y="4" width="18" height="18"/><circle cx="13" cy="13" r="6"/><path d="m5 5 16 16M21 5 5 21"/>
    {%- endcase -%}
  </svg>
{%- elsif name == 'accessibility' -%}
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 6.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM4 8.2c2.7.7 5.3 1 8 1s5.3-.3 8-1l.4 1.6c-2 .6-4.1 1-6.2 1.1v3.6l2 7.3-1.6.5L12.5 16h-1l-2.1 6.3-1.6-.5 2-7.3v-3.6c-2.1-.1-4.2-.5-6.2-1.1Z"/></svg>
{%- else -%}
  <svg class="icon{% if name == 'arrow' or name == 'arrow-back' %} icon--fwd{% endif %}{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ paths }}</svg>
{%- endif -%}
