<!doctype html>
{%- liquid
  assign lang = request.locale.iso_code | split: '-' | first
  assign dir = 'ltr'
  if lang == 'he' or lang == 'ar' or lang == 'fa' or lang == 'ur'
    assign dir = 'rtl'
  endif
-%}
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ dir }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{{ shop.name }}</title>
    <link rel="icon" type="image/png" href="{{ 'favicon.png' | asset_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Assistant:wght@200..800&display=swap">
    {{ 'bliss.css' | asset_url | stylesheet_tag }}
    {% render 'theme-styles' %}
    {{ content_for_header }}
  </head>
  <body>
    <main id="main">{{ content_for_layout }}</main>
  </body>
</html>
