<section class="club" style="min-height: 100dvh; display: grid; place-items: center; padding-block: 48px">
  <div class="container club__inner">
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="483" height="158" style="height: 44px; width: auto">
    <h1 class="h-2xl">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="lede">{{ shop.password_message }}</p>{%- endif -%}
    {%- render 'subscribe-form', id: 'password-newsletter', code: '', tags: 'newsletter,launch' -%}
    <details style="margin-top: 24px; font-size: var(--fs-sm)">
      <summary style="cursor: pointer">{{ 'password.owner' | t }}</summary>
      {%- form 'storefront_password', class: 'subscribe', style: 'margin-top: 12px' -%}
        <div class="subscribe__row">
          <label class="visually-hidden" for="store-password">{{ 'password.label' | t }}</label>
          <input id="store-password" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
          <button class="btn" type="submit">{{ 'password.enter' | t }}</button>
        </div>
        {%- if form.errors -%}<p class="notice notice--error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "BLISS נפתחת בקרוב" } ]
}
{% endschema %}
