{%- assign c = section.settings.collection | default: collections.all -%}
<section class="section--tight" style="padding-inline: var(--pad)">
  <div class="sec-title">
    <h2 class="thin">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="muted">{{ section.settings.subheading | escape }}</p>{%- endif -%}
  </div>
  <div class="carousel" data-carousel>
    <button type="button" class="carousel__arrow carousel__arrow--prev" data-carousel-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-back' %}</button>
    <div class="carousel__track" data-carousel-track>
      {%- for product in c.products limit: section.settings.limit -%}
        {%- render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 68vw' -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card"><div class="card__media">{{ 'product-apparel-' | append: i | placeholder_svg_tag: 'card__img' }}</div><div class="card__info"><p class="card__title">{{ 'products.placeholder' | t }}</p></div></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
    <button type="button" class="carousel__arrow carousel__arrow--next" data-carousel-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
    <div class="carousel__dots" data-carousel-dots></div>
  </div>
  {%- if section.settings.link_label != blank -%}
    <div class="carousel__foot"><a class="text-link" href="{{ c.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New collection" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "הפריטים החדשים" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty shows all products." },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" }
  ],
  "presets": [ { "name": "Product carousel" } ]
}
{% endschema %}
