{%- paginate search.results by 24 -%}
  <section class="page-head">
    <div class="container page-head__inner">
      <h1 class="h-2xl">{{ 'search.title' | t }}</h1>
      <form class="search-box" action="{{ routes.search_url }}" method="get" role="search" style="width: min(560px, 100%)">
        {%- render 'icon', name: 'search' -%}
        <label class="visually-hidden" for="search-page-q">{{ 'search.title' | t }}</label>
        <input id="search-page-q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
        <input type="hidden" name="type" value="product">
      </form>
    </div>
  </section>
  <section class="container section--tight">
    {%- if search.performed -%}
      <p class="toolbar__count" style="margin-bottom: 20px">{{ 'search.results_for' | t: terms: search.terms, results: search.results_count }}</p>
      {%- if search.results_count > 0 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card', product: item -%}
            {%- else -%}
              <a class="card" href="{{ item.url }}" style="text-decoration: none; padding: 20px; border: 1px solid var(--line)">
                <span class="eyebrow">{{ item.object_type }}</span>
                <span class="card__title">{{ item.title | escape }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="empty-state"><p>{{ 'search.no_results' | t: q: search.terms }}</p></div>
      {%- endif -%}
      {%- render 'pagination', paginate: paginate -%}
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{ "name": "Search results" }
{% endschema %}
