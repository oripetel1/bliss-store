{%- paginate collection.products by section.settings.per_page -%}
  {%- liquid
    assign active_count = 0
    for filter in collection.filters
      if filter.type == 'price_range'
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_count = active_count | plus: 1
        endif
      else
        assign active_count = active_count | plus: filter.active_values.size
      endif
    endfor
    assign sort_by = collection.sort_by | default: collection.default_sort_by
  -%}
  <section class="page-head">
    <div class="container page-head__inner">
      <nav class="crumbs" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span>{{ collection.title | escape }}</span></nav>
      <div class="page-head__row">
        <h1 class="page-head__title">{{ collection.title | escape }}<span class="sup">({{ collection.products_count | prepend: '0' | slice: -2, 2 }})</span></h1>
        {%- if collection.description != blank -%}<div class="page-head__desc">{{ collection.description | strip_html | truncate: 160 }}</div>{%- endif -%}
      </div>
      <nav class="chips" style="padding: 0" aria-label="{{ 'collections.categories' | t }}">
        {%- for link in section.settings.chips_menu.links -%}
          <a class="chip{% if link.active or link.current %} is-active{% endif %}" href="{{ link.url }}">{{ link.title | escape }}</a>
        {%- endfor -%}
      </nav>
    </div>
  </section>

  <div class="toolbar">
    <div class="container toolbar__inner">
      <div class="chips">
        {%- for filter in collection.filters -%}
          {%- if filter.presentation == 'swatch' or filter.label == 'צבע' or filter.label == 'Color' -%}
            {%- for value in filter.values limit: 14 -%}
              <a class="chip chip--swatch{% if value.active %} is-active{% endif %}" href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}" aria-pressed="{{ value.active }}"><span class="swatch" style="--swatch: {% render 'swatch-style', value: value.label %}"></span>{{ value.label | escape }}</a>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
      <span class="toolbar__sep"></span>
      {%- if collection.filters.size > 0 -%}
        <button type="button" class="chip" data-open="drawer-filters">{{ 'collections.filter' | t }}{% if active_count > 0 %} ({{ active_count }}){% endif %}</button>
      {%- endif -%}
      <label class="visually-hidden" for="sort-by">{{ 'collections.sort' | t }}</label>
      <select id="sort-by" class="select" name="sort_by" form="collection-filters">
        {%- for option in collection.sort_options -%}
          <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name | escape }}</option>
        {%- endfor -%}
      </select>
      <div class="view-toggle" data-view-toggle data-target="#collection-grid" data-default="{{ section.settings.columns }}" role="group" aria-label="{{ 'collections.view' | t }}">
        {%- for n in (2..4) -%}
          <button type="button" data-cols="{{ n }}" aria-pressed="false" aria-label="{{ n }}"><svg viewBox="0 0 16 16" aria-hidden="true">{% for i in (1..n) %}{% assign x = i | minus: 1 | times: 16 | divided_by: n %}<rect x="{{ x }}.5" y="1" width="{{ 16 | divided_by: n | minus: 1 }}.4" height="14" rx=".5"/>{% endfor %}</svg></button>
        {%- endfor -%}
      </div>
    </div>
  </div>

  <section class="container section--tight">
    {%- if active_count > 0 -%}
      <div class="active-filters">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a class="chip is-active" href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' -%}
            {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
              <a class="chip is-active" href="{{ filter.url_to_remove }}">{{ filter.min_value.value | default: 0 | money }}–{{ filter.max_value.value | default: filter.range_max | money }} ×</a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        <a class="chip" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ 'collections.clear' | t }}</a>
      </div>
    {%- endif -%}
    <p class="toolbar__count" style="margin-bottom: 20px">{{ 'collections.items' | t: count: collection.products_count }}</p>
    {%- if collection.products.size > 0 -%}
      <div class="grid" id="collection-grid" style="--cols: {{ section.settings.columns }}">
        {%- for product in collection.products -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="empty-state"><p>{{ 'collections.empty' | t }}</p><a class="btn btn--ghost btn--sm" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a></div>
    {%- endif -%}
    {%- render 'pagination', paginate: paginate -%}
  </section>

  {%- if collection.filters.size > 0 -%}
    <dialog id="drawer-filters" class="drawer" aria-labelledby="filters-title">
      <div class="drawer__head">
        <h2 id="filters-title" class="drawer__title">{{ 'collections.filter' | t }}</h2>
        <button type="button" class="icon-btn" data-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>
      <form id="collection-filters" class="drawer__body" action="{{ collection.url }}" method="get">
        {%- for filter in collection.filters -%}
          <details class="filter-group" open>
            <summary>{{ filter.label | escape }}{% render 'icon', name: 'plus', class: 'icon--sm' %}</summary>
            {%- case filter.type -%}
              {%- when 'price_range' -%}
                <div class="price-range">
                  <label class="visually-hidden" for="price-min">{{ 'collections.from' | t }}</label>
                  <input id="price-min" type="number" inputmode="numeric" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="{{ 'collections.from' | t }}" min="0">
                  <span aria-hidden="true">–</span>
                  <label class="visually-hidden" for="price-max">{{ 'collections.to' | t }}</label>
                  <input id="price-max" type="number" inputmode="numeric" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | remove: ',' }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" min="0">
                </div>
              {%- else -%}
                <div class="filter-group__list">
                  {%- for value in filter.values -%}
                    {%- assign fid = 'filter-' | append: filter.param_name | handle | append: '-' | append: forloop.index0 -%}
                    <label class="check" for="{{ fid }}">
                      <input id="{{ fid }}" type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                      {%- if filter.presentation == 'swatch' or value.swatch -%}
                        <span class="swatch" style="--swatch: {% render 'swatch-style', value: value.label %}"></span>
                      {%- endif -%}
                      {{ value.label | escape }}
                      <small>{{ value.count }}</small>
                    </label>
                  {%- endfor -%}
                </div>
            {%- endcase -%}
          </details>
        {%- endfor -%}
      </form>
      <div class="drawer__foot">
        <button class="btn btn--block" type="submit" form="collection-filters">{{ 'collections.apply' | t }}</button>
        <a class="link-btn" style="justify-self: center" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a>
      </div>
    </dialog>
  {%- endif -%}
  <script>
    (function () {
      var s = document.getElementById('sort-by');
      if (!s) return;
      s.addEventListener('change', function () {
        var u = new URL(location.href);
        u.searchParams.set('sort_by', s.value);
        u.searchParams.delete('page');
        location.href = u.toString();
      });
    })();
  </script>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 3, "default": 24 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "link_list", "id": "chips_menu", "label": "Category chips menu", "default": "main-menu", "info": "Shown as quick links above the grid." },
    { "type": "paragraph", "content": "Filters come from the Search & Discovery app (colour, size, price)." }
  ]
}
{% endschema %}
