<section class="news-band">
  <div class="wrap news-band__inner">
    <h2 class="news-band__title">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- render 'subscribe-form', id: 'band-newsletter', code: section.settings.code, tags: 'newsletter,band' -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter band",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "הישארו מעודכנות" },
    { "type": "text", "id": "text", "label": "Text", "default": "10% על ההזמנה הראשונה, גישה מוקדמת למבצעים והשקות לפני כולן." },
    { "type": "text", "id": "code", "label": "Discount code shown after sign-up", "default": "WELCOME10" }
  ],
  "presets": [ { "name": "Newsletter band" } ]
}
{% endschema %}
