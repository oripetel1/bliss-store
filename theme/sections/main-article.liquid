<article>
  <section class="page-head">
    <div class="container page-head__inner">
      <nav class="crumbs" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ blog.url }}">{{ blog.title | escape }}</a></nav>
      <h1 class="h-2xl">{{ article.title | escape }}</h1>
      <p class="muted">{{ article.published_at | date: format: 'date' }}</p>
    </div>
  </section>
  <section class="container section">
    <div class="narrow" style="display: grid; gap: 32px">
      {%- if article.image -%}
        {{ article.image | image_url: width: 1600 | image_tag: widths: '750, 1100, 1600', sizes: '(min-width: 800px) 760px, 100vw', alt: article.image.alt }}
      {%- endif -%}
      <div class="rte">{{ article.content }}</div>
      <a class="link-arrow" href="{{ blog.url }}">{{ 'blogs.back' | t }}{% render 'icon', name: 'arrow' %}</a>
    </div>
  </section>
</article>

{% schema %}
{ "name": "Article" }
{% endschema %}
