{%- comment -%}
  "You may also like". Loaded after page load through Shopify's recommendations endpoint.
{%- endcomment -%}
<section class="section" style="padding-top: 0" data-recommendations-section>
  <div class="container">
    <div class="sec-head"><div class="sec-head__text"><h2 class="h-2xl">{{ section.settings.heading | escape }}</h2></div></div>
    <div class="grid grid--4" data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related">
      {%- if recommendations.performed? and recommendations.products_count > 0 -%}
        {%- for rec in recommendations.products -%}
          {%- render 'product-card', product: rec, sizes: '(min-width: 990px) 23vw, 50vw' -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "You may also like",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "אולי תאהבי גם" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
