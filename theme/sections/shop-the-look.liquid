{%- assign looks = section.blocks | where: 'type', 'hotspot' -%}
<section class="wrap section" style="padding-top: clamp(24px, 3vw, 48px)">
  <div class="sec-title">
    <h2 class="thin">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="muted">{{ section.settings.subheading | escape }}</p>{%- endif -%}
  </div>
  <div class="stl" data-stl>
    <div class="stl__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', alt: section.settings.image_alt }}
      {%- else -%}
        <img src="{{ 'look.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1000" height="1333">
      {%- endif -%}
      {%- for block in looks -%}
        {%- if block.settings.product != blank -%}
          <button type="button" class="stl__dot" data-stl-dot style="left: {{ block.settings.x }}%; top: {{ block.settings.y }}%" aria-label="{{ block.settings.product.title | escape }}" {{ block.shopify_attributes }}></button>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="stl__side">
      <div class="stl__slides">
        {%- for block in looks -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            <div class="stl__slide{% if forloop.first %} is-active{% endif %}" data-stl-slide data-product-card data-handle="{{ p.handle }}"{% if block.settings.color != blank %} data-active-color="{{ block.settings.color | escape }}"{% endif %}>
              <a class="stl__slide-img" href="{{ p.url }}">{{ p.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', alt: p.title }}</a>
              <p class="stl__slide-title">{{ p.title | escape }}{% if block.settings.color != blank %} · {{ block.settings.color | escape }}{% endif %}</p>
              {%- render 'price', product: p -%}
              <a class="btn btn--sm" href="{{ p.url }}">{{ 'products.show_product' | t }}</a>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if looks.size > 1 -%}
        <div class="stl__nav">
          <button type="button" class="btn-circle btn-circle--sm" data-stl-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-back' %}</button>
          <span data-stl-count dir="ltr">1 / {{ looks.size }}</span>
          <button type="button" class="btn-circle btn-circle--sm" data-stl-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop the look",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the look" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "לבן על טאופ" },
    { "type": "image_picker", "id": "image", "label": "Outfit photo" },
    { "type": "text", "id": "image_alt", "label": "Image description (alt text)", "default": "דוגמנית בחולצת קשירה לבנה וחצאית קפלים רחבה" }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "color", "label": "Colour in the photo", "info": "e.g. לבן" },
        { "type": "range", "id": "x", "label": "Point, left to right", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "y", "label": "Point, top to bottom", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 }
      ]
    }
  ],
  "presets": [ { "name": "Shop the look", "blocks": [ { "type": "hotspot" }, { "type": "hotspot" } ] } ]
}
{% endschema %}
