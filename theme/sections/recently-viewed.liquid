{%- comment -%} Filled in by bliss.js from the shopper's browsing on this device. {%- endcomment -%}
<section class="section" style="padding-top: 0" data-recent-section hidden>
  <div class="container">
    <div class="sec-head"><div class="sec-head__text"><h2 class="h-2xl">{{ section.settings.heading | escape }}</h2></div></div>
    <div class="grid grid--4" data-recently-viewed data-exclude="{{ product.handle }}" data-limit="{{ section.settings.limit }}"></div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "צפית לאחרונה" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "Recently viewed" } ]
}
{% endschema %}
