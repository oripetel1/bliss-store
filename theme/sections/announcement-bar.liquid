{%- if section.blocks.size > 0 -%}
  <div class="announce" data-announcements data-speed="{{ section.settings.speed | times: 1000 }}" {{ section.shopify_attributes }}>
    <div class="container announce__inner">
      {%- for block in section.blocks -%}
        <p class="announce__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "משלוח חינם בכל הזמנה מעל ₪299" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Announcement bar", "blocks": [ { "type": "announcement" } ] }
  ]
}
{% endschema %}
