{%- assign c = section.settings.collection | default: collections.all -%}
<section class="section"{% if section.settings.no_top_space %} style="padding-top: 0"{% endif %}>
  <div class="container">
    <div class="sec-head">
      <div class="sec-head__text">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h-3xl">{{ section.settings.heading | escape }}<span class="sup">({{ c.products_count | at_most: section.settings.limit | prepend: '0' | slice: -2, 2 }})</span></h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ c.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}{% render 'icon', name: 'arrow' %}</a>
      {%- endif -%}
    </div>
    <div class="{% if section.settings.staggered %}edit{% else %}grid{% endif %}" style="--cols: {{ section.settings.columns }}">
      {%- for product in c.products limit: section.settings.limit -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          <div class="card">
            <div class="card__media">{{ 'product-apparel-' | append: i | placeholder_svg_tag: 'card__img' }}</div>
            <div class="card__info"><p class="card__title">{{ 'products.placeholder' | t }}</p></div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "חדש באתר" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "הפריטים החדשים" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty shows all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "לכל הקולקציה" },
    { "type": "checkbox", "id": "staggered", "label": "Staggered editorial layout (3 columns)", "default": true },
    { "type": "checkbox", "id": "no_top_space", "label": "Remove space above", "default": false }
  ],
  "presets": [ { "name": "Product grid" } ]
}
{% endschema %}
