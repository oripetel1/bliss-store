<section class="split">
  {%- for block in section.blocks limit: 2 -%}
    {%- assign tile = forloop.index -%}
    <a class="split__tile" href="{{ block.settings.link | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 600px) 50vw, 100vw', alt: '' }}
      {%- else -%}
        <img src="{{ 'split-' | append: tile | append: '.jpg' | asset_url }}" alt="" loading="lazy" width="1200" height="1600">
      {%- endif -%}
      <span class="split__copy">
        <span class="split__title">{{ block.settings.title | escape }}</span>
        {%- if block.settings.subtitle != blank -%}<span class="split__sub">{{ block.settings.subtitle | escape }}</span>{%- endif -%}
      </span>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Two category tiles",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "שמלות" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "שמלות מקסי ליום ולערב" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [ { "name": "Two category tiles", "blocks": [ { "type": "tile" }, { "type": "tile" } ] } ]
}
{% endschema %}
