{%- comment -%}
  Customer quotes, one at a time. Add real quotes as blocks, or your reviews app's block.
  Hidden on the live store until it has content.
{%- endcomment -%}
{%- assign quotes = section.blocks | where: 'type', 'quote' -%}
{%- if section.blocks.size > 0 -%}
  <section class="section">
    <div class="wrap quotes" data-quotes>
      <div class="quotes__side">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.score != blank -%}
          <div class="quotes__score"><b>{{ section.settings.score | escape }}</b><span style="display: grid; gap: 6px"><span class="stars"><span class="stars__row" aria-hidden="true"></span></span><span class="mono muted" style="font-size: var(--fs-micro)">{{ section.settings.count_text | escape }}</span></span></div>
        {%- endif -%}
        {%- if quotes.size > 1 -%}
          <div class="quotes__nav">
            <button type="button" class="btn-circle btn-circle--sm" data-quote-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-back' %}</button>
            <button type="button" class="btn-circle btn-circle--sm" data-quote-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</button>
            <div class="quotes__dots" style="margin-inline-start: 12px">{% for q in quotes %}<button type="button" data-quote-dot="{{ forloop.index0 }}" aria-label="{{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>{% endfor %}</div>
          </div>
        {%- endif -%}
      </div>
      <div class="quotes__stage" aria-live="polite">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div {{ block.shopify_attributes }}>{% render block %}</div>
            {%- when 'quote' -%}
              {%- assign p = block.settings.product -%}
              <figure class="quote{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
                <span class="stars"><span class="stars__row" style="--pct: {{ block.settings.rating | times: 20 }}%" aria-hidden="true"></span><span class="visually-hidden">{{ 'products.rating' | t: rating: block.settings.rating, max: 5 }}</span></span>
                <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
                <figcaption>
                  {%- if p != blank -%}{{ p.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                  <span>{{ block.settings.author | escape }}
                    {%- if p != blank -%}<small><a href="{{ p.url }}">{{ p.title | escape }}</a></small>{%- endif -%}
                    {%- if block.settings.verified -%}<span class="verified">{% render 'icon', name: 'check', class: 'icon--sm' %} {{ 'products.verified' | t }}</span>{%- endif -%}
                  </span>
                </figcaption>
              </figure>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="section"><div class="wrap"><p class="notice">{{ 'sections.testimonials_empty' | t }}</p></div></section>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "max_blocks": 9,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "לקוחות מספרות" },
    { "type": "text", "id": "score", "label": "Average score (optional)", "info": "Only a real figure, e.g. from your reviews app." },
    { "type": "text", "id": "count_text", "label": "Review count text", "info": "e.g. 128 ביקורות" },
    { "type": "paragraph", "content": "Use real customer words only. You can also add your reviews app block (for example Judge.me)." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "quote",
      "name": "Customer quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Name", "info": "First name and initial" },
        { "type": "product", "id": "product", "label": "Product bought" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase", "default": true }
      ]
    }
  ],
  "presets": [ { "name": "Customer reviews" } ]
}
{% endschema %}
