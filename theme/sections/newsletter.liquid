{%- liquid
  assign show_countdown = false
  if section.settings.countdown_date != blank
    assign end_ts = section.settings.countdown_date | date: '%s' | plus: 0
    assign now_ts = 'now' | date: '%s' | plus: 0
    if end_ts > now_ts
      assign show_countdown = true
    endif
  endif
-%}
<section class="club" id="club">
  <div class="wrap club__inner">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="club__title">{{ section.settings.heading | escape }}</h2>
      <ul class="club__perks">
        {%- for i in (1..3) -%}
          {%- liquid
            assign tk = 'perk_' | append: i
            assign lk = 'perk_' | append: i | append: '_tag'
          -%}
          {%- if section.settings[tk] != blank -%}<li><span class="mono">{{ section.settings[lk] | escape }}</span>{{ section.settings[tk] | escape }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <div>
      {%- if show_countdown -%}
        <div data-countdown-wrap style="display: grid; gap: 18px">
          {%- if section.settings.countdown_label != blank -%}<p class="eyebrow">{{ section.settings.countdown_label | escape }}</p>{%- endif -%}
          <div class="countdown" data-countdown="{{ section.settings.countdown_date | escape }}" data-hide-on-end>
            <span class="countdown__unit"><span class="countdown__num" data-unit="d">00</span><span class="countdown__label">{{ 'countdown.days' | t }}</span></span>
            <span class="countdown__sep" aria-hidden="true">:</span>
            <span class="countdown__unit"><span class="countdown__num" data-unit="h">00</span><span class="countdown__label">{{ 'countdown.hours' | t }}</span></span>
            <span class="countdown__sep" aria-hidden="true">:</span>
            <span class="countdown__unit"><span class="countdown__num" data-unit="m">00</span><span class="countdown__label">{{ 'countdown.minutes' | t }}</span></span>
            <span class="countdown__sep" aria-hidden="true">:</span>
            <span class="countdown__unit"><span class="countdown__num" data-unit="s">00</span><span class="countdown__label">{{ 'countdown.seconds' | t }}</span></span>
          </div>
        </div>
      {%- endif -%}
      <div class="club__form">{%- render 'subscribe-form', id: 'club-newsletter', code: section.settings.code, tags: 'newsletter,club' -%}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Club sign-up",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "מועדון BLISS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "הצטרפי למועדון" },
    { "type": "text", "id": "perk_1_tag", "label": "Perk 1 tag", "default": "10%" },
    { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "הנחה על ההזמנה הראשונה" },
    { "type": "text", "id": "perk_2_tag", "label": "Perk 2 tag", "default": "VIP" },
    { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "גישה מוקדמת למבצעים" },
    { "type": "text", "id": "perk_3_tag", "label": "Perk 3 tag", "default": "B-DAY" },
    { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "הפתעה ביום ההולדת" },
    { "type": "text", "id": "code", "label": "Discount code shown after sign-up", "default": "WELCOME10", "info": "Create this code in Shopify → Discounts first." },
    { "type": "header", "content": "Countdown" },
    { "type": "text", "id": "countdown_label", "label": "Countdown label", "default": "Black Friday בעוד" },
    { "type": "text", "id": "countdown_date", "label": "Ends at", "default": "2026-11-27T00:00:00+02:00", "info": "Format 2026-11-27T00:00:00+02:00. Hidden when empty or in the past." }
  ],
  "presets": [ { "name": "Club sign-up" } ]
}
{% endschema %}
