{%- comment -%} A section for app blocks, e.g. the Judge.me reviews widget. {%- endcomment -%}
<section class="section"{% if section.settings.no_top_space %} style="padding-top: 0"{% endif %} id="reviews">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="sec-head"><div class="sec-head__text"><h2 class="h-2xl">{{ section.settings.heading | escape }}</h2></div></div>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {% render block %}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Apps",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "checkbox", "id": "no_top_space", "label": "Remove space above", "default": false }
  ],
  "blocks": [ { "type": "@app" } ],
  "presets": [ { "name": "Apps" } ]
}
{% endschema %}
